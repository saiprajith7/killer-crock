<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/policyconfig.dtd">
<policyconfig>
  <vendor>BOSS-Sentinel</vendor>
  <vendor_url>https://github.com/saiprajith7/killer-crock</vendor_url>
  <action id="org.bosssentinel.helper">
    <description>Run BOSS-Sentinel privileged heal/optimize helper</description>
    <message>Authentication is required to auto-heal and optimize system performance</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/boss-sentinel/boss-sentinel-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
