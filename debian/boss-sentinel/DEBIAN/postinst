#!/bin/sh
set -e

case "$1" in
    configure)
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
        fi
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi
        if [ -n "${SUDO_USER:-}" ] && command -v systemctl >/dev/null 2>&1; then
            sudo -u "$SUDO_USER" XDG_RUNTIME_DIR="/run/user/$(id -u "$SUDO_USER")" \
                systemctl --user daemon-reload >/dev/null 2>&1 || true
            sudo -u "$SUDO_USER" XDG_RUNTIME_DIR="/run/user/$(id -u "$SUDO_USER")" \
                systemctl --user enable boss-sentinel-daemon.service >/dev/null 2>&1 || true
        fi
        ;;
esac


# Automatically added by dh_python3
if command -v py3compile >/dev/null 2>&1; then
	py3compile -p boss-sentinel 
fi
if command -v pypy3compile >/dev/null 2>&1; then
	pypy3compile -p boss-sentinel  || true
fi

# End automatically added section
# Automatically added by dh_installsystemduser/13.14.1ubuntu5
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -z "${DPKG_ROOT:-}" ] ; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper --user unmask 'boss-sentinel-daemon.service' >/dev/null || true

		# was-enabled defaults to true, so new installations run enable.
		if deb-systemd-helper --quiet --user was-enabled 'boss-sentinel-daemon.service' ; then
			# Enables the unit on first installation, creates new
			# symlinks on upgrades if the unit file has changed.
			deb-systemd-helper --user enable 'boss-sentinel-daemon.service' >/dev/null || true
		else
			# Update the statefile to add new symlinks (if any), which need to be
			# cleaned up on purge. Also remove old symlinks.
			deb-systemd-helper --user update-state 'boss-sentinel-daemon.service' >/dev/null || true
		fi
	fi
fi
# End automatically added section


exit 0
