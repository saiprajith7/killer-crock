#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        if [ -n "${SUDO_USER:-}" ] && command -v systemctl >/dev/null 2>&1; then
            sudo -u "$SUDO_USER" XDG_RUNTIME_DIR="/run/user/$(id -u "$SUDO_USER")" \
                systemctl --user disable --now boss-sentinel-daemon.service >/dev/null 2>&1 || true
        fi
        ;;
esac


# Automatically added by dh_python3
if command -v py3clean >/dev/null 2>&1; then
	py3clean -p boss-sentinel 
else
	dpkg -L boss-sentinel | sed -En -e '/^(.*)\/(.+)\.py$/s,,rm "\1/__pycache__/\2".*,e'
	find /usr/lib/python3/dist-packages/ -type d -name __pycache__ -empty -print0 | xargs --null --no-run-if-empty rmdir
fi

# End automatically added section


exit 0
