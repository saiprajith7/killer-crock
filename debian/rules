#!/usr/bin/make -f

export DH_VERBOSE = 1
export PYBUILD_NAME = boss-sentinel

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	# Privileged helper
	install -d debian/boss-sentinel/usr/libexec/boss-sentinel
	install -m 0755 scripts/vitaheal-helper debian/boss-sentinel/usr/libexec/boss-sentinel/boss-sentinel-helper
	# Quiet GUI launcher (filters Mesa/EGL driver chatter on stderr)
	install -d debian/boss-sentinel/usr/bin
	install -m 0755 scripts/boss-sentinel debian/boss-sentinel/usr/bin/boss-sentinel
	ln -sf boss-sentinel debian/boss-sentinel/usr/bin/vitaheal
	# Desktop + icon — desktop file name MUST match Gio application_id so
	# GNOME/shell taskbar shows our logo instead of a generic gear icon.
	install -d debian/boss-sentinel/usr/share/applications
	install -m 0644 data/desktop/vitaheal.desktop \
		debian/boss-sentinel/usr/share/applications/org.bosssentinel.BossSentinel.desktop
	ln -sf org.bosssentinel.BossSentinel.desktop \
		debian/boss-sentinel/usr/share/applications/boss-sentinel.desktop
	install -d debian/boss-sentinel/usr/share/icons/hicolor/scalable/apps
	install -m 0644 data/icons/vitaheal.svg \
		debian/boss-sentinel/usr/share/icons/hicolor/scalable/apps/org.bosssentinel.BossSentinel.svg
	ln -sf org.bosssentinel.BossSentinel.svg \
		debian/boss-sentinel/usr/share/icons/hicolor/scalable/apps/boss-sentinel.svg

	# Polkit
	install -d debian/boss-sentinel/usr/share/polkit-1/actions
	install -m 0644 data/polkit/org.vitaheal.policy debian/boss-sentinel/usr/share/polkit-1/actions/org.bosssentinel.policy
	# systemd user unit
	install -d debian/boss-sentinel/usr/lib/systemd/user
	install -m 0644 data/systemd/vitaheal-daemon.service debian/boss-sentinel/usr/lib/systemd/user/boss-sentinel-daemon.service
	# Autostart with graphical session
	install -d debian/boss-sentinel/etc/xdg/autostart
	install -m 0644 data/desktop/vitaheal-daemon.desktop debian/boss-sentinel/etc/xdg/autostart/boss-sentinel-daemon.desktop
	# Bundled dependency .debs (installed by postinst if missing)
	install -d debian/boss-sentinel/usr/share/boss-sentinel/bundled-debs
	install -m 0644 packaging/bundled-debs/*.deb \
		debian/boss-sentinel/usr/share/boss-sentinel/bundled-debs/

override_dh_builddeb:
	mkdir -p dist
	dh_builddeb --destdir=dist
