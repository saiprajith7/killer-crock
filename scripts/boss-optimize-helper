#!/usr/bin/env python3
"""Privileged BOSS-Optimize helper — invoked via pkexec / polkit.

Outputs one JSON object on stdout:
  {"ok": true|false, "message": "...", "details": "..."}
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path


def emit(ok: bool, message: str, details: str = "") -> int:
    print(json.dumps({"ok": ok, "message": message, "details": details}))
    return 0 if ok else 1


def cpu_performance() -> int:
    changed = 0
    cpu = Path("/sys/devices/system/cpu")
    for gov in cpu.glob("cpu[0-9]*/cpufreq/scaling_governor"):
        try:
            gov.write_text("performance\n")
            changed += 1
        except OSError:
            pass
    if changed:
        return emit(True, f"CPU governor set to performance on {changed} cores")
    # Fallback: powerprofilesctl
    try:
        proc = subprocess.run(
            ["powerprofilesctl", "set", "performance"],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if proc.returncode == 0:
            return emit(True, "Platform power profile set to performance")
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    return emit(False, "Could not set CPU performance governor")


def power_performance() -> int:
    try:
        proc = subprocess.run(
            ["powerprofilesctl", "set", "performance"],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if proc.returncode == 0:
            return emit(True, "powerprofilesctl → performance")
        return emit(False, "powerprofilesctl failed", proc.stderr.strip())
    except FileNotFoundError:
        return emit(False, "powerprofilesctl not installed")
    except subprocess.TimeoutExpired:
        return emit(False, "powerprofilesctl timed out")


def io_boost() -> int:
    details = []
    # Prefer mq-deadline / none where writable
    for queue in Path("/sys/block").glob("*/queue/scheduler"):
        try:
            avail = queue.read_text()
            pick = None
            for cand in ("none", "mq-deadline", "kyber", "bfq"):
                if cand in avail.replace("[", " ").replace("]", " ").split():
                    pick = cand
                    break
            if pick:
                queue.write_text(pick + "\n")
                details.append(f"{queue.parent.parent.name}={pick}")
        except OSError:
            continue
    if details:
        return emit(True, "I/O schedulers updated", "; ".join(details[:8]))
    return emit(False, "No I/O schedulers were writable")


def renice_background(pids: list[str]) -> int:
    ok_n = 0
    details = []
    for pid in pids:
        try:
            os.setpriority(os.PRIO_PROCESS, int(pid), 10)
            ok_n += 1
            details.append(pid)
        except (OSError, ValueError) as exc:
            details.append(f"{pid}:{exc}")
    return emit(ok_n > 0, f"Reniced {ok_n} background processes", ", ".join(details[:12]))


def ionice_background(pids: list[str]) -> int:
    ok_n = 0
    details = []
    for pid in pids:
        try:
            proc = subprocess.run(
                ["ionice", "-c", "3", "-p", str(int(pid))],
                capture_output=True,
                text=True,
                timeout=5,
            )
            if proc.returncode == 0:
                ok_n += 1
                details.append(pid)
            else:
                details.append(f"{pid}:rc{proc.returncode}")
        except (FileNotFoundError, ValueError, subprocess.TimeoutExpired) as exc:
            details.append(f"{pid}:{exc}")
    return emit(ok_n > 0, f"ionice idle applied to {ok_n} processes", ", ".join(details[:12]))


def drop_caches() -> int:
    os.sync()
    try:
        Path("/proc/sys/vm/drop_caches").write_text("3\n")
        return emit(True, "Page caches dropped")
    except OSError as exc:
        return emit(False, f"drop_caches failed: {exc}")


ACTIONS = {
    "cpu_performance": lambda args: cpu_performance(),
    "power_performance": lambda args: power_performance(),
    "io_boost": lambda args: io_boost(),
    "renice_background": lambda args: renice_background(args),
    "ionice_background": lambda args: ionice_background(args),
    "drop_caches": lambda args: drop_caches(),
}


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        return emit(False, "Helper must run as root via pkexec")
    if len(argv) < 2:
        return emit(False, "Usage: boss-optimize-helper <action> [args...]")
    action = argv[1]
    fn = ACTIONS.get(action)
    if not fn:
        return emit(False, f"Unknown action: {action}")
    return fn(argv[2:])


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
