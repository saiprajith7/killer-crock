#!/usr/bin/env python3
"""Privileged BOSS-Optimize helper — invoked via pkexec / polkit.

Outputs one JSON object on stdout:
  {"ok": true|false, "message": "...", "details": "..."}
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path


def emit(ok: bool, message: str, details: str = "") -> int:
    print(json.dumps({"ok": ok, "message": message, "details": details}))
    return 0 if ok else 1


def cpu_performance() -> int:
    changed = 0
    cpu = Path("/sys/devices/system/cpu")
    for gov in cpu.glob("cpu[0-9]*/cpufreq/scaling_governor"):
        try:
            gov.write_text("performance\n")
            changed += 1
        except OSError:
            pass
    if changed:
        return emit(True, f"CPU governor set to performance on {changed} cores")
    # Fallback: powerprofilesctl
    try:
        proc = subprocess.run(
            ["powerprofilesctl", "set", "performance"],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if proc.returncode == 0:
            return emit(True, "Platform power profile set to performance")
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    return emit(False, "Could not set CPU performance governor")


def power_performance() -> int:
    try:
        proc = subprocess.run(
            ["powerprofilesctl", "set", "performance"],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if proc.returncode == 0:
            return emit(True, "powerprofilesctl → performance")
        return emit(False, "powerprofilesctl failed", proc.stderr.strip())
    except FileNotFoundError:
        return emit(False, "powerprofilesctl not installed")
    except subprocess.TimeoutExpired:
        return emit(False, "powerprofilesctl timed out")


def io_boost() -> int:
    details = []
    # Prefer mq-deadline / none where writable
    for queue in Path("/sys/block").glob("*/queue/scheduler"):
        try:
            avail = queue.read_text()
            pick = None
            for cand in ("none", "mq-deadline", "kyber", "bfq"):
                if cand in avail.replace("[", " ").replace("]", " ").split():
                    pick = cand
                    break
            if pick:
                queue.write_text(pick + "\n")
                details.append(f"{queue.parent.parent.name}={pick}")
        except OSError:
            continue
    if details:
        return emit(True, "I/O schedulers updated", "; ".join(details[:8]))
    return emit(False, "No I/O schedulers were writable")


def renice_background(pids: list[str]) -> int:
    ok_n = 0
    details = []
    for pid in pids:
        try:
            os.setpriority(os.PRIO_PROCESS, int(pid), 10)
            ok_n += 1
            details.append(pid)
        except (OSError, ValueError) as exc:
            details.append(f"{pid}:{exc}")
    return emit(ok_n > 0, f"Reniced {ok_n} background processes", ", ".join(details[:12]))


def ionice_background(pids: list[str]) -> int:
    ok_n = 0
    details = []
    for pid in pids:
        try:
            proc = subprocess.run(
                ["ionice", "-c", "3", "-p", str(int(pid))],
                capture_output=True,
                text=True,
                timeout=5,
            )
            if proc.returncode == 0:
                ok_n += 1
                details.append(pid)
            else:
                details.append(f"{pid}:rc{proc.returncode}")
        except (FileNotFoundError, ValueError, subprocess.TimeoutExpired) as exc:
            details.append(f"{pid}:{exc}")
    return emit(ok_n > 0, f"ionice idle applied to {ok_n} processes", ", ".join(details[:12]))


def drop_caches() -> int:
    os.sync()
    try:
        Path("/proc/sys/vm/drop_caches").write_text("3\n")
        return emit(True, "Page caches dropped")
    except OSError as exc:
        return emit(False, f"drop_caches failed: {exc}")


def clear_apt_cache() -> int:
    try:
        proc = subprocess.run(
            ["apt-get", "clean"],
            capture_output=True,
            text=True,
            timeout=90,
        )
        return emit(
            proc.returncode == 0,
            "APT archive cache cleaned",
            proc.stderr.strip() or proc.stdout.strip(),
        )
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        return emit(False, f"apt-get clean failed: {exc}")


def clear_tmp_scratch() -> int:
    removed = 0
    for root in (Path("/tmp"), Path("/var/tmp")):
        if not root.exists():
            continue
        for p in root.iterdir():
            name = p.name
            if name.startswith(".") or name in {"systemd-private"}:
                continue
            if name.startswith(("boss-optimize-", "vitaheal-", "tmp.", "scrap-", "cache-")):
                try:
                    if p.is_file():
                        p.unlink()
                        removed += 1
                    elif p.is_dir():
                        for child in p.rglob("*"):
                            if child.is_file():
                                try:
                                    child.unlink()
                                    removed += 1
                                except OSError:
                                    pass
                except OSError:
                    continue
    return emit(True, f"Cleared scratch temp files ({removed} removed)")


def clear_user_cache(paths: list[str]) -> int:
    """Clear given cache directories (passed from UI; still root-capable)."""
    import shutil

    freed = 0
    details = []
    targets = paths or [str(Path.home() / ".cache")]
    # When running as root via pkexec, HOME may be /root — prefer SUDO_UID home
    sudo_uid = os.environ.get("PKEXEC_UID") or os.environ.get("SUDO_UID")
    home = Path.home()
    if sudo_uid and sudo_uid.isdigit():
        try:
            import pwd

            home = Path(pwd.getpwuid(int(sudo_uid)).pw_dir)
        except Exception:  # noqa: BLE001
            pass
    default_cache = home / ".cache"
    if not paths:
        targets = [str(default_cache)]

    for raw in targets:
        path = Path(raw)
        if not path.exists():
            details.append(f"missing:{path}")
            continue
        # Safety: only under home .cache, or known system cache dirs
        allowed = False
        try:
            resolved = path.resolve()
            if str(resolved).startswith(str((home / ".cache").resolve())):
                allowed = True
            if str(resolved).startswith("/var/cache/apt"):
                allowed = True
        except OSError:
            allowed = False
        if not allowed:
            details.append(f"skipped:{path}")
            continue
        try:
            if path.is_dir():
                for child in path.iterdir():
                    try:
                        if child.is_dir():
                            shutil.rmtree(child, ignore_errors=True)
                        else:
                            child.unlink()
                        freed += 1
                    except OSError:
                        continue
            details.append(str(path))
        except OSError as exc:
            details.append(f"{path}:{exc}")
    return emit(True, f"User/system cache cleared ({freed} entries)", "; ".join(details[:8]))


def clear_all_caches() -> int:
    msgs = []
    drop_caches()
    msgs.append("drop_caches")
    clear_apt_cache()
    msgs.append("apt_clean")
    clear_tmp_scratch()
    msgs.append("tmp_scratch")
    clear_user_cache([])
    msgs.append("user_cache")
    return emit(True, "Full cache clear attempted", ", ".join(msgs))


ACTIONS = {
    "cpu_performance": lambda args: cpu_performance(),
    "power_performance": lambda args: power_performance(),
    "io_boost": lambda args: io_boost(),
    "renice_background": lambda args: renice_background(args),
    "ionice_background": lambda args: ionice_background(args),
    "drop_caches": lambda args: drop_caches(),
    "clear_apt_cache": lambda args: clear_apt_cache(),
    "clear_tmp_scratch": lambda args: clear_tmp_scratch(),
    "clear_user_cache": lambda args: clear_user_cache(args),
    "clear_all_caches": lambda args: clear_all_caches(),
}


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        return emit(False, "Helper must run as root via pkexec")
    if len(argv) < 2:
        return emit(False, "Usage: boss-optimize-helper <action> [args...]")
    action = argv[1]
    fn = ACTIONS.get(action)
    if not fn:
        return emit(False, f"Unknown action: {action}")
    return fn(argv[2:])


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
