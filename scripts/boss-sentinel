#!/usr/bin/env bash
# Launcher for BOSS-Sentinel (installed or local build)
set -euo pipefail
BIN=""
for cand in /usr/lib/boss-sentinel/boss-sentinel-bin \
            "$(dirname "$0")/../build/boss-sentinel-bin" \
            "$(dirname "$0")/../build/Release/boss-sentinel-bin"; do
  if [[ -x "$cand" ]]; then
    BIN="$cand"
    break
  fi
done
if [[ -z "$BIN" ]]; then
  echo "boss-sentinel: binary not found. Build with cmake or install the .deb." >&2
  exit 1
fi

# Only prepend bundled libs if present AND system gtkmm is missing
LIBDIR="$(dirname "$BIN")"
if [[ -e "$LIBDIR/libgtkmm-4.0.so.0" ]] && ! ldconfig -p 2>/dev/null | grep -q 'libgtkmm-4.0.so.0'; then
  export LD_LIBRARY_PATH="${LIBDIR}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

export BOSS_SENTINEL_HELPER="${BOSS_SENTINEL_HELPER:-/usr/libexec/boss-sentinel/boss-sentinel-helper}"
exec "$BIN" "$@"
